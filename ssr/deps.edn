;; The frontend server (SSR). Versions of replicant and reitit-core must equal
;; those in ../shadow-cljs.edn (scripts/check/frontend_deps.clj versions).
{:paths ["src" "resources"]
 :deps {zandy/shared {:local/root "../src/shared"}
        org.clojure/clojure {:mvn/version "1.12.4"}
        no.cjohansen/replicant {:mvn/version "2026.07.1"}
        metosin/reitit-core {:mvn/version "0.9.1"}
        io.pedestal/pedestal.service {:mvn/version "0.8.1"}
        io.pedestal/pedestal.jetty {:mvn/version "0.8.1"}
        metosin/jsonista {:mvn/version "0.3.13"}
        integrant/integrant {:mvn/version "1.0.1"}
        aero/aero {:mvn/version "1.1.6"}
        metosin/malli {:mvn/version "0.20.3"}
        org.slf4j/slf4j-nop {:mvn/version "2.0.17"}}
 :aliases
 {:run {:main-opts ["-m" "zandy.ssr.system"]}
  :test {:extra-paths ["test" "dev" "../test/shared" "../test/frontend" "../scripts/build"]
         :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner" "-d" "test" "-d" "../test/shared" "-d" "../test/frontend"]}
  :stub {:extra-paths ["dev"]
         :main-opts ["-m" "zandy.ssr.stub-api"]}
  :proxy {:extra-paths ["dev"]
          :main-opts ["-m" "zandy.ssr.dev-proxy"]}}}
