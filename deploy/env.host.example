# COMPOSE variables (non-secret). Real file on the server: /srv/zandy/compose/.env
# deploy.sh keeps PROD_RELEASE, STAGING_RELEASE and PREVIOUS_* up to date; the rest is set once.

# Which environments this host runs: staging | staging,production | production. Set by server-setup.sh.
# deploy.sh uploads only the Caddy site files of these roles and refuses to deploy any other.
HOST_ROLES=staging,production
# Compose files: compose.yaml alone is the 8 GB layout. A 4 GB staging-only host uses
# compose.yaml:compose.small.yaml (smaller transactor heap and limits).
COMPOSE_FILE=compose.yaml

# Release tags of the zandy/backend and zandy/ssr images (the git commit, set by deploy.sh).
PROD_RELEASE=none
STAGING_RELEASE=none
PREVIOUS_PROD_RELEASE=none
PREVIOUS_STAGING_RELEASE=none

# Pinned by scripts/ops/check-versions.sh against com.datomic/peer in deps.edn.
TRANSACTOR_TAG=1.0.7745
CADDY_TAG=2.11-alpine

# Public host names. The role this host does not have is set to unused.invalid. Before DNS exists use sslip.io names built from the server IPv4 address with dashes:
#   PROD_HOST=prod.203-0-113-10.sslip.io        STAGING_HOST=staging.203-0-113-10.sslip.io
# After DNS: PROD_HOST=zandytouch.com           STAGING_HOST=staging.zandytouch.com
PROD_HOST=CHANGE_ME
STAGING_HOST=CHANGE_ME

# OPTIONAL. Address Let's Encrypt writes to about certificate problems (not published). Leave it empty to register
# without one. deploy.sh turns it into caddy/acme-email.conf.
ACME_EMAIL=
