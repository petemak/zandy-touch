# FRONTEND SERVER (ssr) environment, PRODUCTION. Template. No secrets at all: ssr holds none.
# Real file on the server: /etc/zandy/ssr.production.env   (owner root, mode 600)
# Names are read by ssr/resources/ssr-config.edn.

# The internal proxy address (Caddy's production listener), NOT the public URL and NOT the CDN.
API_BASE_URL=http://caddy:8088

# Same value as SITE_BASE_URL in production.env.
SITE_BASE_URL=https://zandytouch.com

# true only for the real site, and only after the owner has approved all four policy texts: with
# true, ssr refuses to start while any policy is still a placeholder (launch gate). false makes
# robots.txt "Disallow: /", adds X-Robots-Tag noindex and an empty sitemap.
# Production starts as false and is switched to true in Phase 2 (RUNBOOK, "Go live").
SITE_INDEXABLE=false

# Set explicitly: some shells and tools export an API_TIMEOUT_MS of their own, and ssr rejects
# values above 60000 at start.
API_TIMEOUT_MS=3000

# Page cache lifetimes: leave unset to use the defaults from architecture.md D2.
# PAGE_CACHE_CATALOGUE=
# PAGE_CACHE_INFO=
# PAGE_CACHE_SHELL=
# PAGE_CACHE_NOT_FOUND=

# Set by compose.yaml: PORT=8081  STATIC_DIR=/srv/static  JAVA_OPTS=...
