# FRONTEND SERVER (ssr) environment, STAGING. Template. No secrets.
# Real file on the server: /etc/zandy/ssr.staging.env   (owner root, mode 600)

# Caddy's staging listener: staging ssr talks to the staging backend (database zandy-staging) only.
API_BASE_URL=http://caddy:8089

# Same value as SITE_BASE_URL in staging.env.
SITE_BASE_URL=https://staging.CHANGE_ME_SERVER_IP_WITH_DASHES.sslip.io

# Staging is never indexable: robots.txt "Disallow: /", X-Robots-Tag noindex, empty sitemap.
# scripts/ops/check-env.sh refuses to deploy staging with anything else.
SITE_INDEXABLE=false

API_TIMEOUT_MS=3000
