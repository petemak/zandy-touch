[Unit]
Description=Zandy Touch monthly restore test (newest R2 backup into a scratch database)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
Group=zandyops
SupplementaryGroups=docker
ExecStart=/srv/zandy/bin/restore-test.sh --remote
TimeoutStartSec=2h
Nice=10
