[Unit]
Description=Zandy Touch nightly backup (Datomic backup-db and media to Cloudflare R2)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
Group=zandyops
SupplementaryGroups=docker
ExecStart=/srv/zandy/bin/backup.sh
TimeoutStartSec=2h
Nice=10
