# BACKEND environment, STAGING. Template: names and placeholders only.
# Real file on the server: /etc/zandy/staging.env   (owner root, mode 600, NEVER in git or chat)
# Create it with scripts/ops/server-setup.sh, then fill the secrets with scripts/ops/set-secret.sh.
# A value "CHANGE_ME..." is a placeholder; scripts/ops/check-env.sh refuses to deploy while one remains.
# Names are read by resources/config.edn (Aero). Lines marked SECRET must never be logged or pasted anywhere.
#
# Staging and production differ ONLY in the values below (architecture.md section 5, check D-7).

# --- Datomic (SECRET: the URI carries the storage password) ---------------------------------------
# datomic:dev://transactor:4334/<database>?password=<DATOMIC_STORAGE_PASSWORD of transactor.env>
# Staging names the database "zandy-staging" (same transactor, separate data).
DATOMIC_URI=datomic:dev://transactor:4334/zandy-staging?password=CHANGE_ME_DATOMIC_STORAGE_PASSWORD

# --- Session and CSRF (SECRET, at least 32 characters; the app refuses to start with less) --------
SESSION_HMAC_SECRET=CHANGE_ME_RANDOM_48_CHARS

# --- Owner account (used by the bootstrap-owner step of deploy.sh, once) --------------------------
# Staging has its own owner account in its own database; use a different initial password.
# OWNER_EMAIL is also the From address and the new-order alert recipient. It is not secret.
OWNER_EMAIL=CHANGE_ME_owner_gmail_address
# SECRET. Needed only for the first deploy. The owner must change it at first sign-in. After the owner
# has signed in, delete this line (set-secret.sh --unset OWNER_INITIAL_PASSWORD).
OWNER_INITIAL_PASSWORD=CHANGE_ME_INITIAL_OWNER_PASSWORD

# --- Email through Gmail (decision 7) --------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# The Gmail address that owns the app password (normally equal to OWNER_EMAIL).
SMTP_USER=CHANGE_ME_gmail_address
# SECRET. The 16-character Google app password. Entered by the account holder with set-secret.sh.
SMTP_PASSWORD=CHANGE_ME_GMAIL_APP_PASSWORD
# Staging shares the Gmail daily allowance with production: keep this low.
MAIL_DAILY_CAP=50

# --- Site ------------------------------------------------------------------------------------------
# Public origin of STAGING. sslip.io name until the domain exists, then https://staging.zandytouch.com.
SITE_BASE_URL=https://staging.CHANGE_ME_SERVER_IP_WITH_DASHES.sslip.io
# The proxy sets this header from the verified client address (deploy/Caddyfile). Do not change.
CLIENT_IP_HEADER=x-client-ip

# --- Optional public details (defaults are in resources/config.edn; uncomment only to override) ----
# SITE_PHONE=
# WHATSAPP_NUMBER=
# PUBLIC_EMAIL=
# SHOP_ADDRESS=
# SOCIAL_INSTAGRAM=
# SOCIAL_TIKTOK=
# SOCIAL_FACEBOOK=

# --- Set by compose.yaml, listed so nobody adds them here by mistake ------------------------------
# ZANDY_PROFILE=prod  PORT=8080  MEDIA_DIR=/data/media  JAVA_OPTS=...
