# BACKUP environment (rclone to Cloudflare R2). Template.
# Real file on the server: /etc/zandy/backup.env   (owner root, mode 600, NEVER in git or chat)
# rclone reads RCLONE_CONFIG_<REMOTE>_<OPTION> variables, so no rclone.conf file with keys is needed.

RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACL=private
# The bucket is created by the account holder; a token scoped to one bucket cannot create buckets.
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com   (the account id is shown in the R2 dashboard; not secret)
RCLONE_CONFIG_R2_ENDPOINT=CHANGE_ME
# SECRET. From the R2 API token (Object Read and Write, limited to the one bucket).
RCLONE_CONFIG_R2_ACCESS_KEY_ID=CHANGE_ME
# SECRET.
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=CHANGE_ME

# Name of the bucket (not secret).
BACKUP_BUCKET=CHANGE_ME
# Optional: keep the production database name and the paths the scripts use.
# BACKUP_DB=zandy
