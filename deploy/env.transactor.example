# DATOMIC TRANSACTOR environment. Template.
# Real file on the server: /etc/zandy/transactor.env   (owner root, mode 600, NEVER in git or chat)
# Rendered into the transactor properties by deploy/transactor/entrypoint.sh.

# Name the backends use to reach the transactor on the private Docker network (the compose service).
DATOMIC_ALT_HOST=transactor

# SECRET, at least 16 characters, letters and digits only (they sit inside a URI).
DATOMIC_STORAGE_ADMIN_PASSWORD=CHANGE_ME_RANDOM
# SECRET, at least 16 characters, letters and digits only. This is the "?password=" in DATOMIC_URI of
# production.env and staging.env.
DATOMIC_STORAGE_PASSWORD=CHANGE_ME_RANDOM
